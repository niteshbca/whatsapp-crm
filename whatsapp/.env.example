# Port the WhatsApp service listens on
PORT=3001

# Laravel backend base URL (used for progress callbacks)
LARAVEL_URL=http://127.0.0.1:8000

# Shared secret that Laravel also has as PROVIDER_TOKEN in backend/.env
PROVIDER_TOKEN=crm-provider-secret-change-me

# Where the WhatsApp Web session is stored (keeps you logged in between restarts)
SESSION_DIR=.wwebjs_auth

# Random delay between campaign messages (seconds)
DELAY_MIN=2
DELAY_MAX=5